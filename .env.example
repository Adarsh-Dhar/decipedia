# Demo data is the default for development. Set this explicitly for production builds.
NEXT_PUBLIC_APP_DATA_MODE=demo

# Optional API adapter. The API schema is not implemented yet.
BACKEND_API_URL=

# Optional Supabase account and profile features.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback supported by the Supabase client:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Optional Gno network display/configuration. Signing remains disabled until a
# supported GnoConnect provider and verified article realm contract are supplied.
NEXT_PUBLIC_GNO_NETWORK_LABEL=
NEXT_PUBLIC_GNO_RPC_URL=
NEXT_PUBLIC_GNO_CHAIN_ID=
NEXT_PUBLIC_GNO_ARTICLE_REALM=
NEXT_PUBLIC_GNOCONNECT_TX_DOMAINS=
