# Keep demo mode until the backend API and authentication contracts are agreed.
NEXT_PUBLIC_APP_DATA_MODE=demo

# Server-only backend configuration. Do not prefix secrets with NEXT_PUBLIC_.
BACKEND_API_URL=

# Optional public network display/configuration. Set only for a confirmed Gno network.
NEXT_PUBLIC_GNO_NETWORK_LABEL=
NEXT_PUBLIC_GNO_RPC_URL=
NEXT_PUBLIC_GNO_CHAIN_ID=
NEXT_PUBLIC_GNO_ARTICLE_REALM=
NEXT_PUBLIC_GNOCONNECT_TX_DOMAINS=
